{
  "firstmate-primary": {
    "SessionStart": [
      {
        "type": "command",
        "command": "../bin/fm-sessionstart-agy.sh --source startup",
        "timeout": 180
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "../bin/fm-turnend-guard-agy.sh",
        "timeout": 3600
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "../bin/fm-arm-pretool-check.sh --agy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "../bin/fm-cd-pretool-check.sh --agy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
